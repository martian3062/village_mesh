* text=auto
# Preserve exact bytes of inputs checked against published SHA256 hashes.
Content/Well/wind.csv -text whitespace=cr-at-eol
Assets/Geodata/*.osm.json -text
Assets/Geodata/*.geojson -text whitespace=cr-at-eol
*.py text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
Assets/Fonts/* -text
# Keep the pinned upstream licence verbatim, including its original line space.
Assets/Fonts/OFL.txt whitespace=-blank-at-eol
Assets/Models/*.onnx binary
Assets/Farms/*.geojson -text whitespace=cr-at-eol

# Published Unreal packages and pinned CC0 source art use Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
Assets/Downloaded/** filter=lfs diff=lfs merge=lfs -text
Content/V25/** -text whitespace=cr-at-eol
Content/V3/** -text whitespace=cr-at-eol
Content/V25/Fonts/OFL.txt whitespace=cr-at-eol,-blank-at-eol
